0230 00 00        	initial_sp: dw 0
                 	
                 	; SCREEN2.ASM -- TMS9918A Graphics II, BIOS transfers via CALSLT.
                 	; Register geometry from TI TMS9918A Data Manual sections 2.2/2.4.2.
                 	; BIOS addresses/arguments: ASCII Technical Handbook appendix 1, common MSX1.
                 	bios_call:
0232 FD 2A C0 FC  	    ld iy,(EXPTBL-1)
0236 CD 1C 00     	    call CALSLT
0239 FB           	    ei
023A C9           	    ret
                 	
                 	screen_enter:
023B 21 DF F3     	    ld hl,RG0SAV
023E 11 AE 04     	    ld de,saved_regs
0241 01 08 00     	    ld bc,8
0244 ED B0        	    ldir
0246 3A AF FC     	    ld a,(SCRMOD)
0249 32 B6 04     	    ld (saved_mode),a
024C 3A DE F3     	    ld a,(CNSDFG)
024F 32 B7 04     	    ld (saved_cnsdfg),a
0252 3E 01        	    ld a,1
0254 32 DE F3     	    ld (CNSDFG),a
                 	    ; Both source/destination buffers passed to BIOS are outside page 0.
0257 21 00 00     	    ld hl,0
025A 11 00 60     	    ld de,VRAM_BACKUP
025D 01 00 40     	    ld bc,&4000
0260 DD 21 59 00  	    ld ix,&0059
0264 CD 32 02     	    call bios_call
0267 3E 01        	    ld a,1
0269 32 B8 04     	    ld (video_saved),a
026C 3E 02        	    ld a,2
026E 32 AF FC     	    ld (SCRMOD),a
0271 21 A6 04     	    ld hl,screen2_regs
0274 22 B9 04     	    ld (register_ptr),hl
0277 AF           	    xor a
0278 32 BB 04     	    ld (register_index),a
                 	screen_set_reg:
027B 2A B9 04     	    ld hl,(register_ptr)
027E 46           	    ld b,(hl)
027F 3A BB 04     	    ld a,(register_index)
0282 4F           	    ld c,a
0283 DD 21 47 00  	    ld ix,&0047
0287 CD 32 02     	    call bios_call
028A 2A B9 04     	    ld hl,(register_ptr)
028D 23           	    inc hl
028E 22 B9 04     	    ld (register_ptr),hl
0291 3A BB 04     	    ld a,(register_index)
0294 3C           	    inc a
0295 32 BB 04     	    ld (register_index),a
0298 FE 08        	    cp 8
029A C2 7B 02     	    jp nz,screen_set_reg
029D 21 00 00     	    ld hl,0
02A0 01 00 40     	    ld bc,&4000
02A3 AF           	    xor a
02A4 DD 21 56 00  	    ld ix,&0056
02A8 CD 32 02     	    call bios_call
                 	    ; Names 0..255 repeated once per Graphics II third.
02AB 21 00 4F     	    ld hl,NAMES
02AE 01 00 03     	    ld bc,768
02B1 16 00        	    ld d,0
                 	screen_names:
02B3 72           	    ld (hl),d
