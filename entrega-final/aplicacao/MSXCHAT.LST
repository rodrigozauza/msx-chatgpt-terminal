03B6 16 00        	    ld d,0
03B8 21 00 52     	    ld hl,DIRTY
03BB 19           	    add hl,de
03BC 7E           	    ld a,(hl)
03BD 32 BD 04     	    ld (render_flags),a
03C0 E6 01        	    and 1
