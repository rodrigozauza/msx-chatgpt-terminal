0329 32 BB 04     	    ld (register_index),a
032C FE 08        	    cp 8
032E C2 0D 03     	    jp nz,screen_restore_reg
0331 3A B6 04     	    ld a,(saved_mode)
0334 32 AF FC     	    ld (SCRMOD),a
