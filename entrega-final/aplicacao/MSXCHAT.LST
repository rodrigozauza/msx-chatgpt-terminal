02B5 14           	    inc d
02B6 0B           	    dec bc
02B7 78           	    ld a,b
02B8 B1           	    or c
02B9 C2 B3 02     	    jp nz,screen_names
02BC 21 00 4F     	    ld hl,NAMES
02BF 11 00 18     	    ld de,&1800
02C2 01 00 03     	    ld bc,768
02C5 DD 21 5C 00  	    ld ix,&005C
02C9 CD 32 02     	    call bios_call
                 	    ; D0h terminates sprite processing on TMS9918A.
02CC 21 00 1B     	    ld hl,&1B00
02CF 01 01 00     	    ld bc,1
02D2 3E D0        	    ld a,&D0
02D4 DD 21 56 00  	    ld ix,&0056
02D8 CD 32 02     	    call bios_call
