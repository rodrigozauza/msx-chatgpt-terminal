                 	screen_leave:
02E9 3A B8 04     	    ld a,(video_saved)
02EC B7           	    or a
02ED C8           	    ret z
                 	    ; Blank first; restore the saved 16K before restoring visible mode.
02EE 06 A0        	    ld b,&A0
02F0 0E 01        	    ld c,1
02F2 DD 21 47 00  	    ld ix,&0047
02F6 CD 32 02     	    call bios_call
